# Copy to .env, fill in, then:  source .env
# Never commit .env (it's in .gitignore).

# W&B / Weave
# Defaults to the Capital One instance if unset. Weave finds its trace server
# from this automatically (<host>/traces).
export WANDB_BASE_URL=https://wandb.cloud.capitalone.com

# An API key from THAT host: <host>/authorize (or User settings -> API keys)
export WANDB_API_KEY=

# Your team name: the <team> in <host>/<team>/... URLs. Runs land in <team>/<project>.
export WANDB_ENTITY=<your-team>
export WANDB_PROJECT=api-evals-101

# No provider API keys. Every model call goes through Capital One's internal
# inference gateway (c1.aiml.genai.inference), which handles auth itself.

# Optional: override the three candidate model IDs. FM Hosting renames these,
# so run `python 00_check_setup.py` first — on a failure it prints the IDs the
# gateway is actually serving.
# export MODEL_A=openai/gpt-oss-120b
# export MODEL_B=openai/gpt-oss-20b
# export MODEL_C=meta/llama-4-scout

# Optional: the judge. Should be a served model that is NOT one of the three
# candidates; the default overlaps because the served list is short.
# export JUDGE_MODEL=openai/gpt-oss-120b

# Optional
# export TRIALS=3        # run each row 3x to see noise
# export BACKEND=mock    # no gateway calls; plumbing check only
